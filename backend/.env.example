# ======================================================================
# Descubra Rio Verde - configuração
# O instalador (1-instalar) cria o arquivo .env a partir deste e pede a chave do Gemini.
# ======================================================================

# ---------- IA principal: Gemini (online) ----------
# Chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Confira no Google AI Studio o nome do modelo Flash disponível (mantenha o prefixo gemini/)
GEMINI_MODEL=gemini/gemini-3.6-flash
# Segundos que cada chamada ao Gemini pode esperar antes de desistir
LLM_TIMEOUT=30
# Nível de raciocínio do Gemini: minimal (mais rápido), low, medium, high.
# Deixe vazio para o padrão do modelo (mais lento). Se o Gemini der erro, apague o valor.
GEMINI_RACIOCINIO=low
# Tamanho máximo de cada resposta do Gemini
GEMINI_MAX_TOKENS=1200

# ---------- Contingência: IA local Llama (sem internet) ----------
# Modelo open source rodando pelo Ollama (Llama aparece nos slides da Aula 5). Precisa de ~8 GB de RAM.
# Com 16 GB de RAM e placa de vídeo, dá para usar llama3.1:8b (responde melhor, é mais lento).
# Se trocar, rode o 1-instalar de novo para baixar o modelo.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=240
# Tamanho máximo de cada resposta da Llama (menor = mais rápido)
OLLAMA_MAX_TOKENS=500

# ---------- Emergência ----------
# Descomente para forçar um modo para todos os visitantes:
#   offline = só o plano B por regras  |  local = só a Llama  |  gemini = só o Gemini
# MODO_PADRAO=offline

# ---------- "Como chegar" ----------
# Centro de referência da cidade e distância a partir da qual o lugar "precisa de carro"
CENTRO_LAT=-17.7923
CENTRO_LON=-50.9192
LIMITE_CARRO_KM=8
